# Copy to .env and fill in. Never commit .env.
# Load with:  export $(grep -v '^#' .env | xargs)

# --- ECMWF MARS / TIGGE (historical ensemble forecasts) ---
# Register and accept the TIGGE licence at https://apps.ecmwf.int/datasets/licences/tigge/
ECMWF_API_URL=https://api.ecmwf.int/v1
ECMWF_API_KEY=
ECMWF_API_EMAIL=

# --- Copernicus Climate Data Store (ERA5) ---
# Personal Access Token from https://cds.climate.copernicus.eu/profile
CDSAPI_URL=https://cds.climate.copernicus.eu/api
CDSAPI_KEY=

# --- NASA Earthdata (GPM IMERG) ---
# Token from https://urs.earthdata.nasa.gov/ , authorise the GES DISC application
EARTHDATA_TOKEN=

# --- MOSDAC / INSAT (optional, phase 2) ---
MOSDAC_USER=
MOSDAC_PASSWORD=

# --- runtime ---
FBEWS_DATA_MODE=sandbox        # sandbox | real
FBEWS_CONFIG=configs/default.yaml
# ECMWF Open Data, NOAA GEFS/GFS, IBTrACS and the BoM RMM index need no credentials.
